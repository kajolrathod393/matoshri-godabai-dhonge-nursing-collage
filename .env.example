# Copy this file to .env (or .env.local) and fill in the values. Never commit it.

# Which college config to use.
COLLEGE=mgdcon

# MySQL / MariaDB connection string.
#   Local:  mysql://root:yourpassword@localhost:3306/mgdcon
#   Cloud (TiDB Cloud / other hosted MySQL): mysql://USER:PASSWORD@HOST:4000/mgdcon?sslaccept=strict
# Leave empty to run the site without a database (notices come from data/mgdcon/notices.json,
# and the enquiry form asks visitors to call instead).
DATABASE_URL=

# Admin panel (/admin) login.
ADMIN_PASSWORD=
# Long random string used to sign the admin login cookie (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
